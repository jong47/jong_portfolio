# Copy to .env.staging (and .env.prod) and fill in. No defaults — a wrong value
# should fail loudly, not silently fall back to something that half works.
TURNSTILE_SECRET=
# Where contact-form messages land.
CONTACT_EMAIL=
# The SES-verified identity messages are sent FROM. In the SES sandbox both this
# and CONTACT_EMAIL must be verified addresses.
SES_SENDER=
ALLOWED_ORIGINS=http://localhost:5173
AWS_REGION=us-west-1
# Leave both empty in production — an instance role supplies them instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
