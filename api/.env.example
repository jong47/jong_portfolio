# Copy to .env.staging (and .env.prod) and fill in. Every value below is required
# and has no default — a missing or blank one fails at startup with a message naming
# it, rather than silently falling back to something that half works.

# Where contact-form messages land.
CONTACT_EMAIL=
# The SES-verified identity messages are sent FROM. In the SES sandbox both this and
# CONTACT_EMAIL must be verified addresses.
SES_SENDER=
# Comma-separated CORS allowlist. No wildcard. An empty list is rejected.
ALLOWED_ORIGINS=http://localhost:5173
# Where SES lives.
AWS_REGION=us-west-1
# Where Bedrock is called. Separate from AWS_REGION: Bedrock is not in us-west-1.
BEDROCK_REGION=us-west-2
# Claude Haiku 4.5 has no on-demand throughput, so this must be an inference profile
# id, not a bare foundation-model id.
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Left empty in a deployment — the Lambda execution role supplies all three.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional protections. Leave these COMMENTED OUT to disable them; a blank value is
# rejected, so "off" is always deliberate and never a typo. Startup logs a warning
# naming whatever is disabled.
# GUARDRAIL_ID=
# GUARDRAIL_VERSION=DRAFT
# TURNSTILE_SECRET=

# Tuning knobs. These have working defaults; override only to change them.
# MAX_QUERY=1000
# MAX_POSTING=6000
# MAX_MESSAGE=4000
# MAX_OUTPUT_TOKENS=3000
